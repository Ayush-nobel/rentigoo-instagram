# Copy to .env (never commit .env). The same names go into GitHub Secrets / Variables.
IG_ACCESS_TOKEN=          # long-lived Page access token (see README step 3)
IG_USER_ID=               # Instagram professional account ID (see README step 4)
PUBLIC_BASE_URL=          # e.g. https://<your-github-username>.github.io/rentigoo-instagram
GRAPH_VERSION=v25.0       # Graph API version
HASHTAG_LIMIT=5           # hashtags actually published per caption (Instagram caps at 5 since Dec 2025)
